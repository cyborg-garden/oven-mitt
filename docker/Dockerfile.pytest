# The Python tests on Linux, for macOS hosts. `resolve_path` uses
# memfd_create, which only Linux has, so its tests skip on a Mac.
# Build and run from the repo root:
#   docker build -f docker/Dockerfile.pytest -t ovenmitt-pytest .
#   docker run --rm ovenmitt-pytest
# The daemon is built the same way as docker/Dockerfile (shared layers).

FROM rust:1.97-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY tests ./tests
RUN cargo build --release --locked && strip target/release/ovenmitt

FROM python:3.12-slim
WORKDIR /opt/ovenmitt/python
# Not on PATH: the Python package installs an `ovenmitt` console script too,
# which is why the two never share a real image (DEVELOPMENT.md §1).
COPY --from=build /src/target/release/ovenmitt /opt/ovenmitt/daemon/ovenmitt
COPY python/pyproject.toml python/README.md ./
COPY python/src ./src
RUN pip install --no-cache-dir '.[mcp,dev]' && rm -rf /root/.cache
COPY python/tests ./tests
ENV OVENMITT_BIN=/opt/ovenmitt/daemon/ovenmitt
CMD ["python", "-m", "pytest", "tests", "-q"]
