# ovenmitt agent-side image: the Python client library and MCP server.
# Used for the reference `agent` service and the e2e `test-agent`.
# Build from the repo root:
#   docker build -f docker/Dockerfile.agent -t ovenmitt-agent .
# This image never contains the daemon binary, keys, data or audit log.

FROM python:3.12-slim
WORKDIR /opt/ovenmitt
COPY python/pyproject.toml python/README.md ./
COPY python/src ./src
RUN pip install --no-cache-dir . && rm -rf /root/.cache
# The socket volume is mounted here by compose.
VOLUME ["/run/ovenmitt"]
CMD ["ovenmitt", "mcp", "--socket", "/run/ovenmitt/ovenmitt.sock"]
